  "author": "Sam Grimee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgrimee/pi-herdr-intercom.git"
  },
  "bugs": {
    "url": "https://github.com/sgrimee/pi-herdr-intercom/issues"
  },
  "homepage": "https://github.com/sgrimee/pi-herdr-intercom#readme",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
