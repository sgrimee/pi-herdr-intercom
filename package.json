{
  "name": "pi-herdr-intercom",
  "version": "0.1.0",
  "description": "Show pi-intercom identities and message traffic in Herdr's Agents sidebar",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
